# Copy to .env (chmod 600). Never commit .env.

# --- Supabase (multi-tenant Postgres + auth + storage) ---
# From the Supabase project dashboard, or `npx supabase status -o env` for local dev.
NEXT_PUBLIC_SUPABASE_URL=
# Public — safe to ship to the browser. Row Level Security enforces tenancy, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — bypasses Row Level Security. Never expose to the client or log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (AI-assisted manual/receipt extraction) ---
# Server-side only — the key must never reach the client bundle.
ANTHROPIC_API_KEY=sk-ant-...
# Set to "false" to force labelled AI unavailability without removing the key above.
AI_ENABLED=true
# Absolute monthly AI budget cap in USD across every household.
GLOBAL_BUDGET_CAP_USD=50

# --- Cron (vercel.json warranty-check job) ---
# Shared secret the warranty-check cron route checks on incoming requests, so the
# endpoint can't be triggered by anyone who guesses the URL. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Web Push (warranty-expiry and reminder notifications, P5) ---
# Generate a VAPID key pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push service can reach if it needs to flag a problem with our usage.
VAPID_CONTACT=mailto:support@wattkind.ai

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://homekind.wattkind.ai
# Whether receipt/manual metadata is looked up automatically from a scanned barcode
# or model number. Set to "false" to require manual entry only.
NEXT_PUBLIC_AUTOFETCH_ENABLED=true

# --- Tenancy isolation tests only (never set these in a deployed environment) ---
# A disposable Supabase project used solely to prove Row Level Security keeps one
# household's data from another's. Do not point these at production or staging.
TENANCY_TEST_URL=
TENANCY_TEST_ANON_KEY=
TENANCY_TEST_SERVICE_ROLE_KEY=
