# dependencies and build output
node_modules
dist
*.local

# Capacitor / iOS (generated by `npx cap add ios`; Pods are restored by `pod install` on the build machine)
ios/App/Pods
ios/App/App.xcworkspace/xcuserdata
ios/App/App.xcodeproj/xcuserdata
ios/App/build
ios/App/DerivedData
ios/App/public
ios/App/App/public
ios/capacitor-cordova-ios-plugins

# signing material never belongs in the repo - it lives in Codemagic only
*.p8
*.p12
*.mobileprovision
*.cer
*.certSigningRequest

# editors and OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.log

# Android: Gradle output and local SDK path are covered by android/.gitignore; the upload
# keystore lives in Codemagic only, never here
*.jks
*.keystore
android/app/release
